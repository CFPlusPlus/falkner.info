{
  "name": "falkner-editorial-onepager",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "packageManager": "npm@12.2.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/emit-pages-csp.mjs",
    "preview": "astro preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:artifacts && npm run test:browser",
    "test:artifacts": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tabler/icons": "3.51.0",
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.1.18",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^1.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "vite": "8.3.8",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "engines": {
    "node": "^26.0.0",
    "npm": "^12.0.0"
  }
}
